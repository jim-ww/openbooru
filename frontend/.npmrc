engine-strict=true
# Nix's own pnpm (used by flake.nix's fetchPnpmDeps, unlike CI which pins
# pnpm via packageManager) is whatever nixpkgs currently ships and enforces
# this supply-chain policy by default — reject on principle here since the
# lockfile is already pinned and reviewed, not fetched fresh per-install.
minimum-release-age=0
