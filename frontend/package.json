		"vitest": "^4.1.8",
		"storybook": "^10.5.9",
		"@storybook/sveltekit": "^10.5.9",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-a11y": "^10.5.9",
		"@storybook/addon-docs": "^10.5.9"
	},
	"dependencies": {
		"idb-keyval": "^6.3.0",
		"nostr-tools": "^2.24.2"
	},
	"pnpm": {
		"minimumReleaseAge": 0
	}
